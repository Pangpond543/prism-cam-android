<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- phase 5/6: GitHub update check + the PC link page (local network only) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- in-app update: hand the downloaded APK to Android's installer (the user confirms there) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 15+: know when the screen is being shared (clean screen ghosts the shutter at once) -->
    <uses-permission android:name="android.permission.DETECT_SCREEN_RECORDING" />
    <!-- Android 8–9 only: saving into the shared Pictures / Movies folders needs it. 10+ uses MediaStore without it. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".PrismApp"
        android:allowBackup="false"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="Prism Cam"
        android:supportsRtl="false"
        android:theme="@style/Theme.PrismCam">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- configChanges: rotating / resizing never recreates the activity, so the camera keeps running
             (docs/plan.md "Landscape"). Compose re-lays itself out. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
